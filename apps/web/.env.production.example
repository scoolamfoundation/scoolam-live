# ---------------------------------------------------------------------------
# Production environment for scoolam.com (Hostinger VPS).
# Copy to .env.production and fill in real values before building.
#   cp .env.production.example .env.production
#   nano .env.production
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Local Postgres running in docker (see docker-compose.prod.yml).
# POSTGRES_PASSWORD must match the password in docker-compose.prod.yml env.
DATABASE_URL=postgres://scoolam:CHANGE_ME_STRONG_PASSWORD@localhost:5432/scoolam

# neon serverless driver → wsproxy → Postgres. wsproxy runs in docker and is
# reachable on localhost:8080; `pg:5432` is the in-network Postgres hostname.
NEON_WS_PROXY=localhost:8080/v1?address=pg:5432

# --- Auth -------------------------------------------------------------------
# Generate a strong secret:  openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND

# The public HTTPS URL the app is served under.
AUTH_URL=https://scoolam.com
BETTER_AUTH_URL=https://scoolam.com

# Every origin that may call the auth API (CSRF allow-list). For a single domain:
BETTER_AUTH_TRUSTED_ORIGINS=https://scoolam.com

# --- Anything/Platform client vars (safe placeholders; unused on standalone) -
NEXT_PUBLIC_CREATE_BASE_URL=https://scoolam.com
NEXT_PUBLIC_CREATE_HOST=scoolam.com
NEXT_PUBLIC_CREATE_APP_URL=https://scoolam.com
NEXT_PUBLIC_CREATE_ENV=PRODUCTION
NEXT_PUBLIC_PROJECT_GROUP_ID=scoolam-production

# --- Third-party integrations (optional; leave disabled until you have keys) -
STRIPE_SECRET_KEY=
REVENUE_CAT_API_KEY=
REVENUE_CAT_PROJECT_ID=
