# Scoolam mobile app environment.
#
# Copy to .env and adjust:
#   cp .env.example .env
#
# For EAS builds, set these same vars in eas.json (build.<profile>.env) or via
# `eas secret:create`, because .env is NOT bundled into production builds.

# The deployed web backend. All in-app /api/* requests are prefixed with this
# (see src/__create/fetch.ts). Use the public HTTPS URL of the deployment.
EXPO_PUBLIC_BASE_URL=https://scoolam.cloud

# Same host used by the upload proxy path (/_create/api/upload/). Point at the
# same backend as EXPO_PUBLIC_BASE_URL.
EXPO_PUBLIC_PROXY_BASE_URL=https://scoolam.cloud

# Public hostname (no scheme/slash) — sent as the `host` / `x-forwarded-host`
# / `x-createxyz-host` headers so the backend resolves the right project.
EXPO_PUBLIC_HOST=scoolam.cloud

# Project group id used by the backend to scope data. Keep in sync with the
# backend's NEXT_PUBLIC_PROJECT_GROUP_ID.
EXPO_PUBLIC_PROJECT_GROUP_ID=scoolam-production
